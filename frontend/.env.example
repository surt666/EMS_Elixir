# AWS Cognito Configuration
# Copy this file to .env and fill in your actual values

# Cognito User Pool ID (format: region_XXXXXXXXX)
PUBLIC_USER_POOL_ID=eu-central-1_XXXXXXXXX

# Cognito User Pool Client ID (26 character alphanumeric string)
PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# CloudFront Distribution URL
PUBLIC_CLOUDFRONT_URL=https://your-cloudfront-id.cloudfront.net

# API Base URL (typically same as CloudFront URL)
PUBLIC_API_BASE_URL=https://your-cloudfront-id.cloudfront.net
