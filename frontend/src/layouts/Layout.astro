</html>

<script>
	import 'invokers/compatible';
	import { Amplify } from 'aws-amplify';
	import { getCurrentUser, signOut } from 'aws-amplify/auth';

	// Configure Amplify
	Amplify.configure({
		Auth: {
			Cognito: {
				region: 'eu-central-1',
				userPoolId: import.meta.env.PUBLIC_USER_POOL_ID,
				userPoolClientId: import.meta.env.PUBLIC_USER_POOL_CLIENT_ID,
			}
		}
	});

	// Function to initialize auth check
	function initAuth() {
		getCurrentUser()
			.then(() => {
				window.dispatchEvent(new CustomEvent('user-authenticated'));
			})
			.catch(() => {
				window.dispatchEvent(new CustomEvent('user-logged-out'));
			});
	}

	// Function to setup logout handler
	function setupLogout() {
		document.getElementById('logout-btn')?.addEventListener('click', async () => {
			try {
				await signOut();
			} catch (error) {
				console.log('Logout error:', error.message);
			}
			window.dispatchEvent(new CustomEvent('user-logged-out'));
			window.location.href = '/';
		});
	}

	// Initial setup
	initAuth();
	setupLogout();

	// Reinitialize on view transitions
	document.addEventListener('astro:page-load', () => {
		initAuth();
		setupLogout();
	});
</script>
<style is:global>
        :root {
                --accent: 136, 58, 234;
                --accent-light: 224, 204, 250;
                --accent-dark: 49, 10, 101;
                --accent-gradient: linear-gradient(
                        45deg,
                        rgb(var(--accent)),
                        rgb(var(--accent-light)) 30%,
                        white 60%
                );
        }
        html {
                font-family: system-ui, sans-serif;
        }
        code {
                font-family:
                        Menlo,
                        Monaco,
                        Lucida Console,
                        Liberation Mono,
                        DejaVu Sans Mono,
                        Bitstream Vera Sans Mono,
                        Courier New,
                        monospace;
        }
        .hidden {
          display: none;
        }
</style>
