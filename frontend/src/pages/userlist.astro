---
import Layout from '../layouts/Layout.astro';

const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
---

<Layout title="Brugerliste for: Enity">
	<div class="min-h-screen bg-gray-50">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-[1fr_auto_auto] gap-6 px-6 py-3 text-sm" x-data="{
				deleteDialogOpen: false,
				emailToDelete: null,
				openDeleteDialog(email) {
					this.emailToDelete = email;
					this.deleteDialogOpen = true;
					this.$refs.deleteDialog.showModal();
				},
				closeDeleteDialog() {
					this.deleteDialogOpen = false;
					this.$refs.deleteDialog.close();
					this.emailToDelete = null;
				},
				async deleteUser() {
					if (!this.emailToDelete) return;

					try {
						const response = await fetch('/hierarchy/command', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({
								action: 'delete_user',
								data: {
									email: this.emailToDelete
								}
							})
						});

						if (!response.ok) {
							const errorText = await response.text();
							alert('Fejl ved sletning: ' + errorText);
							return;
						}

						this.closeDeleteDialog();
						location.reload();
					} catch (error) {
						alert('Fejl ved sletning: ' + error.message);
					}
				}
			}"
			@delete-user.window="openDeleteDialog($event.detail.email)">
				<div></div>
				<a href="#" _="on click halt the event then call #create-user-dialog.showModal()" class="text-blue-600 hover:text-blue-800">Opret bruger</a>
				<a href="#" class="text-blue-600 hover:text-blue-800">Genindlæs</a>

				<!-- Create User Dialog -->
				<dialog id="create-user-dialog" _="on click if event.target == me then call me.close()" class="rounded-lg shadow-2xl p-0 w-[800px] m-auto">
					<div class="bg-gray-200 bg-opacity-95 px-6 py-4 grid grid-cols-[1fr_auto] items-center border-b border-gray-400">
						<h2 class="text-2xl font-bold text-gray-800">OPRET BRUGER - ENITY</h2>
						<button _="on click call #create-user-dialog.close()" class="btn-close">×</button>
					</div>

					<div class="p-6 bg-white bg-opacity-95">
						<!-- Tab Navigation -->
						<div class="grid grid-cols-[auto_auto_auto] gap-2 mb-6 border-b border-gray-300">
							<button id="tab-btn-bruger" class="btn-tab active"
								_="on click
									add @style='display:none' to #tab-dataadgang
									remove @style from #tab-bruger-detaljer
									add .active to me
									remove .inactive from me
									add .inactive to #tab-btn-dataadgang
									remove .active from #tab-btn-dataadgang">
								Bruger detaljer
							</button>
							<button id="tab-btn-dataadgang" class="btn-tab inactive"
								_="on click
									add @style='display:none' to #tab-bruger-detaljer
									remove @style from #tab-dataadgang
									add .active to me
									remove .inactive from me
									add .inactive to #tab-btn-bruger
									remove .active from #tab-btn-bruger
									then send dataadgangShown to body">
								Dataadgang
							</button>
						</div>

						<!-- Tab Content -->
						<div id="form-error" class="hidden text-red-600 font-bold mb-4"></div>

						<form id="create-user-form" class="space-y-4"
							hx-post={`${API_BASE_URL}/hierarchy/command`}
							hx-swap="none"
							hx-on::after-request="if(event.detail.elt.id === 'create-user-form' && event.detail.successful) { document.querySelector('dialog').close(); location.reload(); } else if(event.detail.elt.id === 'create-user-form') { document.getElementById('form-error').textContent = event.detail.xhr.responseText; document.getElementById('form-error').classList.remove('hidden'); }">
							<input type="hidden" name="action" value="create_user" />

						<!-- Tab 1: Bruger detaljer -->
						<div id="tab-bruger-detaljer">

							<div class="grid grid-cols-[200px_1fr_auto] gap-4 items-center">
								<label class="font-bold text-gray-800">Fuldt navn</label>
								<input type="text" name="data.name" required class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
								<span class="text-red-500 font-bold">*</span>
							</div>

							<div class="grid grid-cols-[200px_1fr_auto_auto_auto] gap-4 items-center">
								<label class="font-bold text-gray-800">Email</label>
								<input type="email" name="data.email" required class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
								<span class="text-red-500 font-bold">*</span>
								<button type="button" class="btn-danger btn-sm">
									<span class="font-bold">•••</span>
								</button>
								<span></span>
							</div>

							<div class="grid grid-cols-[200px_1fr] gap-4 items-center">
								<label class="font-bold text-gray-800">Brugerprofil</label>
								<select name="data.profile" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" hx-get={`${API_BASE_URL}/hierarchy/query/profiles`} hx-request='{"noHeaders": true}' hx-trigger="intersect once" hx-params="none" hx-swap="innerHTML">
									<option value="Developer">Udvikler</option>
									<option value="Standard" selected>Standardbruger</option>
									<option value="Technician">Tekniker</option>
									<option value="Reader">Læser</option>
									<option value="SysAdm">System Administrator</option>
								</select>
							</div>

							<div class="grid grid-cols-[200px_1fr] gap-4 items-center">
								<label class="font-bold text-gray-800">Sprog</label>
								<select name="data.language" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" hx-get={`${API_BASE_URL}/hierarchy/query/languages`} hx-request='{"noHeaders": true}' hx-trigger="intersect once" hx-params="none" hx-swap="innerHTML">
									<option value="Danish" selected>Dansk (Dansk)</option>
									<option value="English">English (English)</option>
								</select>
							</div>

							<div class="grid grid-cols-[200px_1fr] gap-4 items-center">
								<label class="font-bold text-gray-800">Valuta</label>
								<select name="data.currency" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" hx-get={`${API_BASE_URL}/hierarchy/query/currencies`} hx-request='{"noHeaders": true}' hx-trigger="intersect once" hx-params="none" hx-swap="innerHTML">
									<option value="DKK" selected>DKK - danske kroner</option>
									<option value="EUR">EUR - Euro</option>
								</select>
							</div>
						</div>

						<!-- Tab 2: Dataadgang -->
						<div id="tab-dataadgang" style="display:none;">
							<!-- Search field -->
							<div class="mb-4">
								<input type="text" placeholder="Søg efter afdeling, firma, ejendomme, gruppering eller bygninger" class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
							</div>

							<!-- Hierarchy table -->
							<div class="border border-gray-200 rounded grid grid-cols-[auto_auto_auto_1fr] gap-x-2" id="permission-grid">
								<!-- Table header -->
								<div class="col-span-4 p-3 border-b border-gray-200 bg-gray-100" style="display: grid; grid-template-columns: auto auto auto auto auto 1fr; gap: 0.5rem; align-items: center;">
									<div class="w-5"></div>
									<div class="w-4"></div>
									<svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
									<div class="w-4"></div>
									<svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
									<div class="font-bold text-sm">Navn</div>
								</div>

								<!-- Dynamic hierarchy nodes loaded via HTMX -->
								<div class="col-span-4"
									hx-get={`${API_BASE_URL}/hierarchy/query/nodes?permissions=true`}
									hx-vals="js:{user: localStorage.getItem('loginId')}"
									hx-request='{"noHeaders": true}'
									hx-trigger="dataadgangShown from:body once"
									hx-swap="beforeend"
									hx-target="#permission-grid">
								</div>
							</div>
						</div>
						</form>
					</div>

					<!-- Dialog Footer -->
					<div class="bg-gray-100 bg-opacity-95 px-6 py-4 grid grid-cols-[auto_auto_1fr_auto_auto] gap-2 border-t border-gray-300">
						<button
							type="submit"
							form="create-user-form"
							class="btn-warning">Gem</button>
						<button _="on click call #create-user-dialog.close()" class="btn-warning">Luk</button>
						<div></div>
						<button _="on click send click to #tab-btn-bruger" class="btn-secondary">Forrige</button>
						<button _="on click send click to #tab-btn-dataadgang" class="btn-warning">Næste</button>
					</div>
				</dialog>

				<!-- Delete User Confirmation Dialog -->
				<dialog x-ref="deleteDialog" @click.self="closeDeleteDialog()" class="rounded-lg shadow-2xl p-0 w-[500px] m-auto">
					<div class="bg-red-100 bg-opacity-95 px-6 py-4 grid grid-cols-[1fr_auto] items-center border-b border-red-300">
						<h2 class="text-2xl font-bold text-red-800">SLET BRUGER</h2>
						<button @click="closeDeleteDialog()" class="btn-close danger">×</button>
					</div>

					<div class="p-6 bg-white bg-opacity-95">
						<p class="text-gray-800 mb-4">Er du sikker på, at du vil slette denne bruger?</p>
						<p class="text-sm text-gray-600 mb-4">
							Bruger ID: <span class="font-mono font-bold" x-text="emailToDelete"></span>
						</p>
						<p class="text-sm text-red-600 font-bold">
							⚠️ Dette kan ikke fortrydes!
						</p>
					</div>

					<!-- Dialog Footer -->
					<div class="bg-gray-100 bg-opacity-95 px-6 py-4 grid grid-cols-[auto_1fr_auto] gap-2 border-t border-gray-300">
						<button @click="closeDeleteDialog()" class="btn-secondary">
							Annuller
						</button>
						<div></div>
						<button @click="deleteUser()" class="btn-danger">
							Slet
						</button>
					</div>
				</dialog>
			</div>

			<div class="px-6 py-2">
				<h1 class="text-base font-normal text-gray-700">Brugerliste for: Enity</h1>
			</div>

			<div class="mx-6 mt-4 bg-white border border-gray-300 rounded-sm">
				<div class="bg-gray-200 px-4 py-3 font-bold text-sm border-b border-gray-300">
					▼ ALLE BRUGERE MED DATAADGANG
				</div>

				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="bg-gray-100 border-b border-gray-300">
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">NAVN</th>
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">EMAIL</th>
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">BRUGERPROFIL</th>
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">SPROG</th>
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">VALUTA</th>
								<th class="px-4 py-3 text-left font-bold text-xs text-gray-700">HANDLINGER</th>
							</tr>
						</thead>
						<tbody
							hx-get={`${API_BASE_URL}/hierarchy/query/users`}
							hx-request='{"noHeaders": true}'
							hx-trigger="load"
							hx-swap="innerHTML">
							<tr>
								<td class="px-4 py-3 text-center text-gray-500" colspan="5">Loading users...</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	table {
		border-collapse: collapse;
	}

	th {
		cursor: pointer;
		user-select: none;
	}

	th:hover {
		background-color: #d1d5db;
	}

	dialog::backdrop {
		background-color: rgba(0, 0, 0, 0.3);
	}

	.navigation-item__arrow {
		transition: transform 0.2s ease;
	}

	.rotate-90 {
		transform: rotate(90deg);
	}
</style>
