---
import {
  Astronav,
  MenuItems,
  Dropdown,
  DropdownItems,
} from "astro-navbar";

const currentPath = Astro.url.pathname;

// Helper function to check if parent menu is active
const isParentActive = (paths: string[]) => paths.includes(currentPath);
---
<header class="bg-black text-white">
  <div class="container mx-auto px-4 py-3">
    <Astronav>
      <MenuItems class="block w-full"> 
        <div class="nav-grid">
          <ul class="menu-horizontal">
          <li><a href="/main" class={`block nav-link-button ${currentPath === '/main' ? 'active' : ''}`}>Oversigt</a></li>
          <li class="relative">
            <Dropdown class="group">
              <button class={`nav-link-button ${isParentActive(['/rimain', '/rianalysis', '/rienergymodel']) ? 'active' : ''}`}>
                <span>Resource Insights</span><svg aria-hidden="true" focusable="false" class="navigation-item__arrow navigation-item__icon" width="16" height="16"><use href="#chevron-right"></use></svg>
              </button>
              <DropdownItems class="dropdown-items absolute left-0 mt-2 hidden group-open:block z-[100]">
                <ul class="bg-black text-white shadow-lg rounded-md p-2 grid gap-1 min-w-[160px] ">
                  <li><a href="/rimain" class={`block py-1 nav-link-button ${currentPath === '/rimain' ? 'active' : ''}`}>Overblik</a></li>
                  <li><a href="/rianalysis" class={`block py-1 nav-link-button ${currentPath === '/rianalysis' ? 'active' : ''}`}>Analyse</a></li>
                  <li><a href="/rienergymodel" class={`block py-1 nav-link-button ${currentPath === '/rienergymodel' ? 'active' : ''}`}>Energimodel</a></li>
                </ul>
              </DropdownItems>
            </Dropdown>
          </li>
          <li><a href="/callaction" class={`block nav-link-button ${currentPath === '/callaction' ? 'active' : ''}`}>Call to action</a></li>
          <li class="relative">
            <Dropdown class="group">
              <button class={`nav-link-button ${isParentActive(['/bbenchmark', '/abenchmark', '/standbyanalysis']) ? 'active' : ''}`}>
                <span>Analyse</span><svg aria-hidden="true" focusable="false" class="navigation-item__arrow navigation-item__icon" width="16" height="16"><use href="#chevron-right"></use></svg>
              </button>
              <DropdownItems class="dropdown-items absolute left-0 mt-2 hidden group-open:block z-[100]">
                <ul class="bg-black text-white shadow-lg rounded-md p-2 grid gap-1 min-w-[160px]">
                  <li><a href="/bbenchmark" class={`block py-1 nav-link-button ${currentPath === '/bbenchmark' ? 'active' : ''}`}>Bygningsbenchmark</a></li>
                  <li><a href="/abenchmark" class={`block py-1 nav-link-button ${currentPath === '/abenchmark' ? 'active' : ''}`}>Asset benchmark</a></li>
                  <li><a href="/standbyanalysis" class={`block py-1 nav-link-button ${currentPath === '/standbyanalysis' ? 'active' : ''}`}>Standbyanalyse</a></li>
                </ul>
              </DropdownItems>
            </Dropdown>
          </li>
          <li class="relative">
            <Dropdown class="group">
              <button class={`nav-link-button ${isParentActive(['/alarms', '/alarmsetup']) ? 'active' : ''}`}>
                <span>Overvågning</span><svg aria-hidden="true" focusable="false" class="navigation-item__arrow navigation-item__icon" width="16" height="16"><use href="#chevron-right"></use></svg>
              </button>
              <DropdownItems class="dropdown-items absolute left-0 mt-2 hidden group-open:block z-[100]">
                <ul class="bg-black text-white shadow-lg rounded-md p-2 grid gap-1 min-w-[160px]">
                  <li><a href="/alarms" class={`block py-1 nav-link-button ${currentPath === '/alarms' ? 'active' : ''}`}>Alarmer</a></li>
                  <li><a href="/alarmsetup" class={`block py-1 nav-link-button ${currentPath === '/alarmsetup' ? 'active' : ''}`}>Alarm opsætning</a></li>
                </ul>
              </DropdownItems>
            </Dropdown>
          </li>
          <li><a href="/meters" class={`block nav-link-button ${currentPath === '/meters' ? 'active' : ''}`}>Målere</a></li>
          <li><a href="/climate" class={`block nav-link-button ${currentPath === '/climate' ? 'active' : ''}`}>Klimaregnskab</a></li>
          <li><a href="/control" class={`block nav-link-button ${currentPath === '/control' ? 'active' : ''}`}>Aktiv styring</a></li>
          <li class="relative">
            <Dropdown class="group">
              <button class={`nav-link-button ${isParentActive(['/customreports', '/buildingreport', '/exportdata']) ? 'active' : ''}`}>
                <span>Rapportering</span><svg aria-hidden="true" focusable="false" class="navigation-item__arrow navigation-item__icon" width="16" height="16"><use href="#chevron-right"></use></svg>
              </button>
              <DropdownItems class="dropdown-items absolute left-0 mt-2 hidden group-open:block z-[100]">
                <ul class="bg-black text-white shadow-lg rounded-md p-2 grid gap-1 min-w-[160px]">
                  <li><a href="/customreports" class={`block py-1 nav-link-button ${currentPath === '/customreports' ? 'active' : ''}`}>Brugertilpassede rapporter</a></li>
                  <li><a href="/buildingreport" class={`block py-1 nav-link-button ${currentPath === '/buildingreport' ? 'active' : ''}`}>Bygningsrapporten</a></li>
                  <li><a href="/exportdata" class={`block py-1 nav-link-button ${currentPath === '/exportdata' ? 'active' : ''}`}>Eksporter forbrugsdata</a></li>
                </ul>
              </DropdownItems>
            </Dropdown>
          </li>
          <li class="relative">
            <Dropdown class="group">
              <button class={`nav-link-button ${isParentActive(['/masterdata', '/userlist', '/areas']) ? 'active' : ''}`}>
                <span>Opsætning</span><svg aria-hidden="true" focusable="false" class="navigation-item__arrow navigation-item__icon" width="16" height="16"><use href="#chevron-right"></use></svg>
              </button>
              <DropdownItems class="dropdown-items absolute left-0 mt-2 hidden group-open:block z-[100]">
                <ul class="bg-black text-white shadow-lg rounded-md p-2 grid gap-1 min-w-[160px]">
                  <li><a href="/masterdata" class={`block py-1 nav-link-button ${currentPath === '/masterdata' ? 'active' : ''}`}>Stamdata</a></li>
                  <li><a href="/userlist" class={`block py-1 nav-link-button ${currentPath === '/userlist' ? 'active' : ''}`}>Brugerliste</a></li>
                  <li><a href="/areas" class={`block py-1 nav-link-button ${currentPath === '/areas' ? 'active' : ''}`}>Områder</a></li>
                </ul>
              </DropdownItems>
            </Dropdown>
          </li>
          </ul>
          <button id="logout-btn" class="logout-button">
            Logout
          </button>
        </div>
      </MenuItems>
    </Astronav>
  </div>
</header>

<style>
  /* Reset any alignment that might be coming from astro-navbar */
  :global(.astronav-items) {
    width: 100% !important;
    margin: 0 !important;
    justify-self: start !important;
    justify-content: start !important;
    text-align: left !important;
  }

  /* Grid container for navbar */
  .nav-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    width: 100%;
    gap: 2rem;
  }

  /* Force menu alignment to left */
  .menu-horizontal {
    display: grid;
    grid-template-columns: repeat(10, auto);
    justify-content: start !important;
    gap: 2rem;
    margin: 0 !important;
    align-items: center !important; /* Align items vertically center */
  }

  /* Logout button styling */
  .logout-button {
    background-color: #dc2626;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
    margin-right: 1rem;
    justify-self: end;
  }

  .logout-button:hover {
    background-color: #b91c1c;
  }
  
  /* Additional resets for any nested elements */
  :global(.astronav-toggle) {
    width: 100% !important;
    justify-content: start !important;
  }

   /* Style the dropdown button to look like a regular link */
  .nav-link-button {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: grey;
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    display: block;
    font-weight: inherit;
    text-decoration: none;
    line-height: normal;
    vertical-align: middle;
  }

  /* Add hover styles to match link hover if needed */
  .nav-link-button:hover {
    color: #cccccc;
  }

  /* Active state styling */
  .nav-link-button.active {
    color: white;
    font-weight: bold;
    border-bottom: 2px solid #dc2626;
    padding-bottom: 2px;
  }

  /* Remove any button-specific focus styles */
  .nav-link-button:focus {
    outline: none;
  }

  :global(.group-open\:block) {
    display: none;
  }
  
  :global(.group.open .group-open\:block) {
    display: block !important;
  }
  
  /* Make sure dropdowns stay visible while interacting with them */
  :global(.group:focus-within .group-open\:block) {
    display: block !important;
  }

  :global(.group) {
    position: relative;
  }

  :global(.dropdown-items) {
    position: absolute;
    top: 100%;
    left: 0;
  }

  :global(.dropdown-items ul) {
    background-color: white !important;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5) !important;
  }
</style>

<script>
  // Update active menu items when navigating via view transitions
  function updateActiveMenuItems() {
    const currentPath = window.location.pathname;

    // Remove all active classes
    document.querySelectorAll('.nav-link-button.active').forEach(el => {
      el.classList.remove('active');
    });

    // Add active class to current page link
    document.querySelectorAll('.nav-link-button').forEach(link => {
      const href = link.getAttribute('href');
      if (href === currentPath) {
        link.classList.add('active');
      }
    });

    // Update parent menu active state for dropdowns
    const parentMenuPaths = {
      'Resource Insights': ['/rimain', '/rianalysis', '/rienergymodel'],
      'Analyse': ['/bbenchmark', '/abenchmark', '/standbyanalysis'],
      'Overvågning': ['/alarms', '/alarmsetup'],
      'Rapportering': ['/customreports', '/buildingreport', '/exportdata'],
      'Opsætning': ['/masterdata', '/userlist', '/areas']
    };

    // Check if current path belongs to a dropdown and mark parent as active
    Object.values(parentMenuPaths).forEach(paths => {
      if (paths.includes(currentPath)) {
        // Find the parent button for this dropdown
        document.querySelectorAll('.nav-link-button').forEach(button => {
          if (button.tagName === 'BUTTON') {
            const dropdownLinks = button.parentElement?.querySelectorAll('a.nav-link-button');
            dropdownLinks?.forEach(link => {
              if (paths.includes(link.getAttribute('href') || '')) {
                button.classList.add('active');
              }
            });
          }
        });
      }
    });
  }

  // Run on initial load
  updateActiveMenuItems();

  // Run on view transitions
  document.addEventListener('astro:page-load', updateActiveMenuItems);
</script>
