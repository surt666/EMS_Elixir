<div class="max-w-3xl mx-auto p-6 bg-white rounded-lg shadow-md my-8">
  <div class="mb-4">
    <label for="id" class="block font-semibold mb-1 text-gray-700">ID:</label>
    <input type="text" id="id" value={@node.id} readonly class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50">
  </div>
  <div class="mb-4">
    <label for="name" class="block font-semibold mb-1 text-gray-700">Name:</label>
    <input type="text" id="name" value={@node.name} readonly class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50">
  </div>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">Metadata</h2>

    <%= if @node.metadata do %>
      <%= case @node.type do %>
        <% :company -> %>
          <.metadata_type_field type="Company" />
          <.text_field label="Email" value={@node.metadata[:email]} />
          <.address_section address={@node.metadata[:address]} />

        <% :building -> %>
          <.metadata_type_field type="Building" />
          <.text_field label="Email" value={@node.metadata[:email]} />
          <.text_field label="Latitude" value={get_in(@node.metadata, [:location, :lat])} />
          <.text_field label="Longitude" value={get_in(@node.metadata, [:location, :long])} />

        <% :property -> %>
          <.metadata_type_field type="Property" />
          <.text_field label="Latitude" value={get_in(@node.metadata, [:location, :lat])} />
          <.text_field label="Longitude" value={get_in(@node.metadata, [:location, :long])} />
          <.address_section address={@node.metadata[:address]} />

        <% :partner -> %>
          <.metadata_type_field type="Partner" />
          <.text_field label="Email" value={@node.metadata[:email]} />
          <.address_section address={@node.metadata[:address]} />

        <% :area -> %>
          <.metadata_type_field type="Area" />

        <% :group -> %>
          <.metadata_type_field type="Group" />

        <% _ -> %>
          <div class="mb-4">
            <label class="block font-semibold">Unknown metadata type</label>
          </div>
      <% end %>
    <% else %>
      <div class="mb-4">
        <label class="block font-semibold">No metadata available</label>
      </div>
    <% end %>

    <%= if @node.type in [:building, :property, :company, :area] do %>
      <div class="mb-4">
        <div class="grid grid-cols-[1fr_auto] items-center mb-4">
          <h2 class="text-xl font-semibold text-gray-700">
            Sensors
            <span id="loading-indicator" class="htmx-indicator text-sm text-blue-500 ml-2" style="display: none;">Loading...</span>
          </h2>
          <button _="on click call #add-sensor-dialog.showModal()" class="btn-primary">Tilføj sensor</button>
        </div>

        <!-- Add Sensor Dialog -->
        <dialog id="add-sensor-dialog" _="on click if event.target == me then call me.close()" class="rounded-lg shadow-2xl p-0 w-[600px] m-auto">
          <div class="bg-gray-200 bg-opacity-95 px-6 py-4 grid grid-cols-[1fr_auto] items-center border-b border-gray-400">
            <h2 class="text-2xl font-bold text-gray-800">TILFØJ SENSOR</h2>
            <button _="on click call #add-sensor-dialog.close()" class="btn-close">×</button>
          </div>

          <div class="p-6 bg-white bg-opacity-95">
            <div id="sensor-form-error" class="hidden text-red-600 font-bold mb-4"></div>

            <form id="add-sensor-form" class="space-y-4"
              hx-post="/hierarchy/command"
              hx-swap="none"
              hx-on::after-request="if(event.detail.elt.id === 'add-sensor-form' && event.detail.successful) { document.querySelector('#add-sensor-dialog').close(); location.reload(); } else if(event.detail.elt.id === 'add-sensor-form') { document.getElementById('sensor-form-error').textContent = event.detail.xhr.responseText; document.getElementById('sensor-form-error').classList.remove('hidden'); }">
              <input type="hidden" name="action" value="create_sensor" />

              <div class="grid grid-cols-[200px_1fr_auto] gap-4 items-center">
                <label class="font-bold text-gray-800">DAQ Id</label>
                <input type="text" name="data.daq_id" required class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-red-500 font-bold">*</span>
              </div>
            </form>
          </div>

          <!-- Dialog Footer -->
          <div class="bg-gray-100 bg-opacity-95 px-6 py-4 grid grid-cols-[auto_1fr_auto] gap-2 border-t border-gray-300">
            <button type="submit" form="add-sensor-form" class="btn-warning">Gem</button>
            <div></div>
            <button _="on click call #add-sensor-dialog.close()" class="btn-warning">Luk</button>
          </div>
        </dialog>

        <ul id="sensor-list"
          class="space-y-2"
          hx-get="/hierarchy/query/sensors"
          hx-vals={Jason.encode!(%{nodepath: @parent})}
          hx-trigger="load"
          hx-target="#sensor-list"
          hx-swap="innerHTML"
          hx-request='{"noHeaders": true}'
          hx-indicator="#loading-indicator">
          <li class="text-gray-500">Loading sensors...</li>
        </ul>
        <script>
          // For debugging - show the hierarchy path being used
          console.log('Hierarchy path for sensors:', '<%= @parent %>');
        </script>
      </div>
    <% end %>
  </div>
</div>

<style>
  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.3);
  }
</style>
